# Configure no Railway. Não coloque valores secretos no GitHub.
AUTOMATION_ENABLED=false
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Versão suportada pelo aplicativo Meta; exemplo de formato: vNN.N
META_API_VERSION=
WHATSAPP_NUMBER=553491341688
WHATSAPP_CONFIRMED=false
DAILY_ACTION_LIMIT=30

# Automação de conteúdo do Ragnar — agenda local/autoritativa
AUTO_POST_HOURS=9,12,18
# Opcional: use horários com minutos, ex.: 09:00,12:00,18:00
AUTO_POST_TIMES=
SCHEDULE_RETRY_SECONDS=120

# OpenAI PRÓPRIA do Ragnar. Não usa proxy/API do servidor Global Play.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Anexe um volume em /data. Railway define RAILWAY_VOLUME_MOUNT_PATH.

# Painel web do Ragnar
PANEL_PASSWORD=
PANEL_SECRET=
MAX_UPLOAD_MB=300

# Odin - qualificação comercial e funil de leads
ODIN_ENABLED=true
# Opcional: se vazio, o painel /odin usa PANEL_PASSWORD
ODIN_ADMIN_PASSWORD=

# NEXUS AI - somente regras editoriais/controle e telemetria.
# A geração OpenAI é feita diretamente pelo Ragnar com OPENAI_API_KEY.
NEXUS_CONFIG_URL=https://servidor-global-play-production.up.railway.app/api/agent-config/ragnar-one
NEXUS_POST_EVENT_URL=https://servidor-global-play-production.up.railway.app/api/agent/ragnar-one/posts/event
NEXUS_AGENT_TOKEN=
